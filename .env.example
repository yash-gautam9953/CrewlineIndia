# ==============================================================================
# CREWLINE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env.local for local development. Never commit .env.local.
# ==============================================================================

# 1. REQUIRED CORE VARIABLES (7)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=
CREWLINE_ADMIN_IDENTITIES=
CREWLINE_PREVIEW_SECRET=

# API Key scopes needed for automatic table/bucket discovery and app features:
# databases.read, tables.read, rows.read/write, buckets.read, files.read/write,
# users.read/write, sessions.write, execution.read/write, messages.write.

# 2. OPTIONAL / PRODUCTION FEATURE VARIABLES
# Required in Vercel Production for PDF issuance (leave blank locally to use Playwright):
APPWRITE_DOCUMENT_FUNCTION_ID=

# Email delivery ("true" to send via Appwrite Messaging, "false" in dev/preview):
CREWLINE_EMAILS_ENABLED=false

# Bearer secret for /api/cron/deadline-reminders:
CREWLINE_CRON_SECRET=

# Public contact email displayed on info pages:
NEXT_PUBLIC_CONTACT_EMAIL=

# Rate limiting in Production (not needed locally):
# Set CREWLINE_ALLOW_MEMORY_RATE_LIMIT=true if not using Upstash Redis,
# OR provide UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN:
# CREWLINE_ALLOW_MEMORY_RATE_LIMIT=true
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Non-production / explicit remote Chromium PDF fallback:
# BROWSERLESS_API_KEY=
# CHROME_WS_ENDPOINT=

# 3. OPTIONAL LEGACY / EXPLICIT ID OVERRIDES
# Tables and storage buckets resolve automatically by exact name inside
# APPWRITE_DATABASE_ID. Only set APPWRITE_PROJECT_ID, APPWRITE_*_TABLE_ID,
# or APPWRITE_*_BUCKET_ID if you need to pin a specific ID explicitly.
