NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=

APPWRITE_PROJECT_ID=
# Server-only key. For this app's current setup/auth/apply/offer flow, grant only:
# databases.read/write, tables.read/write, columns.read/write, indexes.read/write,
# rows.read/write, buckets.read/write, files.read/write, users.write, sessions.write, messages.write.
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=

APPWRITE_STUDENT_PROFILES_TABLE_ID=
APPWRITE_INTERNSHIPS_TABLE_ID=
APPWRITE_APPLICATIONS_TABLE_ID=
APPWRITE_ENROLLMENTS_TABLE_ID=
APPWRITE_TASKS_TABLE_ID=
APPWRITE_TASK_ASSIGNMENTS_TABLE_ID=
APPWRITE_TASK_RESOURCES_TABLE_ID=
APPWRITE_SUBMISSIONS_TABLE_ID=
APPWRITE_REVIEWS_TABLE_ID=
APPWRITE_PAYMENTS_TABLE_ID=
APPWRITE_CERTIFICATES_TABLE_ID=
APPWRITE_CERTIFICATE_REVOCATIONS_TABLE_ID=
APPWRITE_DOCUMENTS_TABLE_ID=
APPWRITE_NOTIFICATIONS_TABLE_ID=
APPWRITE_AUDIT_LOGS_TABLE_ID=
APPWRITE_WEBSITE_CONTENT_TABLE_ID=

APPWRITE_PROFILE_BUCKET_ID=
APPWRITE_SUBMISSIONS_BUCKET_ID=
APPWRITE_CERTIFICATES_BUCKET_ID=
APPWRITE_DOCUMENTS_BUCKET_ID=

# Comma-separated Appwrite Auth user IDs allowed to open /admin (verified email required).
CREWLINE_ADMIN_IDENTITIES=

# Configure an Email provider in Appwrite Console > Messaging > Providers.
# Offer emails are sent by Appwrite Messaging to each applicant's Auth email.
# Keep real email delivery disabled for local development and test projects.
CREWLINE_EMAILS_ENABLED=false

# Set a long random value before invoking the deadline-reminder route from a scheduler.
CREWLINE_CRON_SECRET=
