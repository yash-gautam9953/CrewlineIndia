# ==============================================================================
# CREWLINE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env.local for local development. Never commit .env.local.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC VARIABLES (Safe for browser / client exposure)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=6afc10e40030343548a0
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=

# ------------------------------------------------------------------------------
# 2. PRIVATE SERVER-SIDE APPWRITE CONFIGURATION
# ------------------------------------------------------------------------------
APPWRITE_PROJECT_ID=6afc10e40030343548a0

# Server-only key. Obtain from Appwrite Console > Project Settings > API Keys:
# Required scopes: databases.*, tables.*, columns.*, indexes.*, rows.*,
# buckets.*, files.*, users.read/write, sessions.write, messages.write.
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=6afc21760027a1281dc5

# ------------------------------------------------------------------------------
# 3. APPWRITE DATABASE TABLES (TablesDB)
# ------------------------------------------------------------------------------
APPWRITE_STUDENT_PROFILES_TABLE_ID=6afc2178000e5d985790
APPWRITE_INTERNSHIPS_TABLE_ID=6afc2186001b2e3f593d
APPWRITE_APPLICATIONS_TABLE_ID=6afc2199001faac393fd
APPWRITE_ENROLLMENTS_TABLE_ID=6afc21a60026710fa615
APPWRITE_TASKS_TABLE_ID=6afc21b200121c312377
APPWRITE_TASK_ASSIGNMENTS_TABLE_ID=6afdf82300255a2755a5
APPWRITE_TASK_RESOURCES_TABLE_ID=6afdf82b000b31ba8eb1
APPWRITE_SUBMISSIONS_TABLE_ID=6afc21c0002d9d294d7f
APPWRITE_REVIEWS_TABLE_ID=6afc21d20027248fd0e0
APPWRITE_PAYMENTS_TABLE_ID=6afdf848003cb1c56980
APPWRITE_CERTIFICATES_TABLE_ID=6afc21dc003dfa3c4bd2
APPWRITE_DOCUMENTS_TABLE_ID=6afcb70600266a154ccd
APPWRITE_AUDIT_LOGS_TABLE_ID=6afc22030034f37f36ae
APPWRITE_WEBSITE_CONTENT_TABLE_ID=6afc2211002c10b638d4

# ------------------------------------------------------------------------------
# 4. APPWRITE STORAGE BUCKETS
# ------------------------------------------------------------------------------
APPWRITE_SUBMISSIONS_BUCKET_ID=6afc221c003e1cd31108
APPWRITE_DOCUMENTS_BUCKET_ID=6afcb719002354770876

# ------------------------------------------------------------------------------
# 5. ACCESS CONTROL & PERMISSIONS
# ------------------------------------------------------------------------------
CREWLINE_ADMIN_IDENTITIES=6afcb1c10016bc3b8c11

# ------------------------------------------------------------------------------
# 6. MESSAGING & NOTIFICATIONS
# ------------------------------------------------------------------------------
CREWLINE_EMAILS_ENABLED=false
CREWLINE_CRON_SECRET=

# ------------------------------------------------------------------------------
# 7. SERVERLESS PDF GENERATION (Optional / Vercel Serverless Production)
# ------------------------------------------------------------------------------
BROWSERLESS_API_KEY=
CHROME_WS_ENDPOINT=
