# ==============================================================================
# CREWLINE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env.local for local development. Never commit .env.local.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED CORE VARIABLES (7 Core Variables)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=
CREWLINE_ADMIN_IDENTITIES=
CREWLINE_PREVIEW_SECRET=

# Note: All Appwrite tables and storage buckets are discovered automatically on the
# server using exact resource names within APPWRITE_DATABASE_ID and the configured
# project. Obtain APPWRITE_API_KEY with tables.read, rows.read/write, buckets.read,
# files.read/write, functions.execute, users.read/write, and messages.write scopes.

# ------------------------------------------------------------------------------
# 2. RECOMMENDED / OPTIONAL FEATURE VARIABLES
# ------------------------------------------------------------------------------
# Required in production for PDF generation via the Appwrite Document Generator Function:
APPWRITE_DOCUMENT_FUNCTION_ID=

# Appwrite Messaging email delivery ("true" to send transactional emails, "false" in dev):
CREWLINE_EMAILS_ENABLED=false

# Bearer secret for /api/cron/deadline-reminders:
CREWLINE_CRON_SECRET=

# Upstash Redis REST rate limiting (required in production for fail-closed rate limiting):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public contact email displayed on info pages:
NEXT_PUBLIC_CONTACT_EMAIL=

# Local / fallback PDF options (non-production or explicit remote Chromium fallback):
BROWSERLESS_API_KEY=
CHROME_WS_ENDPOINT=

# ------------------------------------------------------------------------------
# 3. OPTIONAL BACKWARD-COMPATIBILITY & EXPLICIT RESOURCE OVERRIDES
# ------------------------------------------------------------------------------
# Leave unset unless pinning a specific table or bucket ID. If set, the resolver
# verifies that the ID exists in the configured Appwrite project and database.
# APPWRITE_PROJECT_ID=
# APPWRITE_STUDENT_PROFILES_TABLE_ID=
# APPWRITE_INTERNSHIPS_TABLE_ID=
# APPWRITE_APPLICATIONS_TABLE_ID=
# APPWRITE_ENROLLMENTS_TABLE_ID=
# APPWRITE_TASKS_TABLE_ID=
# APPWRITE_TASK_ASSIGNMENTS_TABLE_ID=
# APPWRITE_TASK_RESOURCES_TABLE_ID=
# APPWRITE_SUBMISSIONS_TABLE_ID=
# APPWRITE_REVIEWS_TABLE_ID=
# APPWRITE_PAYMENTS_TABLE_ID=
# APPWRITE_CERTIFICATES_TABLE_ID=
# APPWRITE_DOCUMENTS_TABLE_ID=
# APPWRITE_AUDIT_LOGS_TABLE_ID=
# APPWRITE_WEBSITE_CONTENT_TABLE_ID=
# APPWRITE_SUBMISSIONS_BUCKET_ID=
# APPWRITE_DOCUMENTS_BUCKET_ID=
