# ======================================
# CREWLINE - VERCEL PRODUCTION / STAGING ENV
# ======================================

# 1. CORE REQUIRED VARIABLES (7)
NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APP_URL=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=
CREWLINE_ADMIN_IDENTITIES=
CREWLINE_PREVIEW_SECRET=

# 2. REQUIRED IN PRODUCTION FOR PDF ISSUANCE
APPWRITE_DOCUMENT_FUNCTION_ID=

# 3. DISTRIBUTED RATE LIMITING (Fail-closed in production when unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 4. OPTIONAL OPERATIONS & MESSAGING
CREWLINE_EMAILS_ENABLED=false
CREWLINE_CRON_SECRET=
NEXT_PUBLIC_CONTACT_EMAIL=

# 5. OPTIONAL PDF FALLBACK (Non-production / remote Chromium)
BROWSERLESS_API_KEY=
CHROME_WS_ENDPOINT=
